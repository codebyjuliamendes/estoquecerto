# Copie para .env (não versionado) ou defina no ambiente de deploy.
PORT=3002
DATABASE_PATH=./data/estoque.sqlite
LOG_LEVEL=info             # debug | info | warn | error | silent
APP_TIMEZONE=America/Sao_Paulo # fuso que define "hoje" para validades
EXPIRY_WARNING_DAYS=3      # janela do alerta "vence em breve"
TRUST_PROXY=0              # 1 atrás de um proxy reverso (Nginx, Fly, Render)
RATE_LIMIT_PER_MINUTE=120  # escritas por IP por minuto; 0 desativa
SEED_DEMO_DATA=            # padrão: true fora de produção, false com NODE_ENV=production
BASIC_AUTH_USER=           # login opcional do painel (defina os dois)
BASIC_AUTH_PASSWORD=       # mínimo de 12 caracteres
BACKUP_KEEP=14             # backups mantidos por `npm run backup`
